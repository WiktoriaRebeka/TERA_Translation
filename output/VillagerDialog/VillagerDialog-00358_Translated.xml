    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">[EN] Over here!&lt;BR&gt;&lt;br&gt;[ES] &amp;#161;Por aqu&amp;#237;!&lt;BR&gt;</Page>
    </Text>
    <Text id="102" endSocial="0">
