<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="2000" huntingZoneId="2503" voiceTypeId="0" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">[EN] So I see you worms have crawled all the way here.&lt;br&gt;[ES] Vaya, as&amp;#237; que ustedes, gusanos, se han arrastrado hasta aqu&amp;#237;.</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">[EN] Ooo, not bad!&lt;br&gt;[ES] &amp;#161;Ooh, nada mal!</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">[EN] You just wait.&lt;br&gt;[ES] Ya ver&amp;#225;n.</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">[EN] I'll erase you and your souls!&lt;br&gt;[ES] &amp;#161;Los borrar&amp;#233; a ustedes y a sus almas!</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0" voiceTypeId="0">[EN] This is your destiny.&lt;br&gt;[ES] Este es su destino.</Page>
    </Text>
    <Text id="106" endSocial="0">
        <Page social="0" voiceTypeId="0">[EN] Mwa hah ha hah!&lt;br&gt;[ES] &amp;#161;Mva ja ja ja ja!</Page>
    </Text>
    <Text id="107" endSocial="0">
        <Page social="0" voiceTypeId="0">[EN] Who are you?&lt;br&gt;[ES] &amp;#191;Qui&amp;#233;nes son?</Page>
    </Text>
    <Text id="108" endSocial="0">
        <Page social="0" voiceTypeId="0">[EN] Grr, what you have done to me, I will never forget.&lt;br&gt;[ES] Grrr, &amp;#161;lo que me has hecho, nunca lo olvidar&amp;#233;!</Page>
    </Text>
    <Text id="109" endSocial="0">
        <Page social="0" voiceTypeId="0">[EN] I'll kill you all!&lt;br&gt;[ES] &amp;#161;Los matar&amp;#233; a todos!</Page>
    </Text>
    <Text id="110" endSocial="0">
        <Page social="0" voiceTypeId="0">[EN] Gah, you insignificant worms!&lt;br&gt;[ES] &amp;#161;Gah, gusanos insignificantes!</Page>
    </Text>
    <Text id="111" endSocial="0">
        <Page social="0" voiceTypeId="0">[EN] No... My power... I'm losing my power...&lt;br&gt;[ES] No... Mi poder... Estoy perdiendo mi poder...</Page>
    </Text>
</VillagerDialog>
