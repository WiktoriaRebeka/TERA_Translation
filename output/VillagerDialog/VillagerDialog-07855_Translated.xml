<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="120" huntingZoneId="2500" voiceTypeId="282" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="0">
        <Page social="4" voiceTypeId="282">[EN] Good job following me this far.&lt;br&gt;[ES] Buen trabajo sigui&amp;#233;ndome hasta aqu&amp;#237;.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0" voiceTypeId="0">[EN] This place is called Oscinium Agaia.&lt;br&gt;[ES] Este lugar se llama Oscinium Agaia.</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0" voiceTypeId="0">[EN] It&amp;#8217;s the center of the world.&lt;br&gt;[ES] Es el centro del mundo.</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0" voiceTypeId="0">[EN] If you still have questions, you can ask others here.&lt;br&gt;[ES] Si a&amp;#250;n tienes dudas, puedes preguntarle a otros aqu&amp;#237;.</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0" voiceTypeId="0">[EN] Now, see you later!&lt;br&gt;[ES] &amp;#161;Hasta luego!</Page>
    </Text>
</VillagerDialog>
