<VillagerDialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://vezel.dev/novadrop/dc/VillagerDialog VillagerDialog.xsd" id="5005" huntingZoneId="410" voiceTypeId="137" xmlns="https://vezel.dev/novadrop/dc/VillagerDialog">
    <Text id="1" endSocial="14">
        <Page social="4">[EN] Father...&lt;BR&gt;&lt;BR&gt;...I will avenge you.&lt;br&gt;[ES] Padre...&lt;BR&gt;&lt;BR&gt;...Te vengar&amp;#233;.</Page>
    </Text>
    <Text id="101" endSocial="0">
        <Page social="0">[EN] Adjutant, gather my troops!&lt;br&gt;[ES] &amp;#161;Ayudante, re&amp;#250;ne a mis tropas!</Page>
    </Text>
    <Text id="102" endSocial="0">
        <Page social="0">[EN] Which units can we mobilize the most quickly?&lt;br&gt;[ES] &amp;#191;Qu&amp;#233; unidades podemos movilizar m&amp;#225;s r&amp;#225;pido?</Page>
    </Text>
    <Text id="103" endSocial="0">
        <Page social="0">[EN] Who?&lt;br&gt;[ES] &amp;#191;Qui&amp;#233;n?</Page>
    </Text>
    <Text id="104" endSocial="0">
        <Page social="0">[EN] You!&lt;br&gt;[ES] &amp;#161;T&amp;#250;!</Page>
    </Text>
    <Text id="105" endSocial="0">
        <Page social="0">[EN] That was your last laugh, clown.&lt;br&gt;[ES] Esa fue tu &amp;#250;ltima risa, payaso.</Page>
    </Text>
    <Text id="106" endSocial="0">
        <Page social="0">[EN] It can't be...Are those my father's horns?&lt;br&gt;[ES] No puede ser... &amp;#191;Esos son los cuernos de mi padre?</Page>
    </Text>
    <Text id="107" endSocial="0">
        <Page social="0">[EN] Guards! Tear him apart!&lt;br&gt;[ES] &amp;#161;Guardias! &amp;#161;H&amp;#225;ganlo trizas!</Page>
    </Text>
    <Text id="108" endSocial="0">
        <Page social="0">[EN] All bow to the Shieldmaiden!&lt;br&gt;[ES] &amp;#161;Todos incl&amp;#237;nense ante la Shieldmaiden!</Page>
    </Text>
</VillagerDialog>
