    <Text id="100" huntingZoneId="205" prevId="0" villagerId="2001">
        <Page social="0">[EN] You collected materials for a tuwangi drum.&lt;br&gt;[ES] Recolectaste materiales para un tambor tuwangi.</Page>
    </Text>
    <Text id="2" huntingZoneId="205" prevId="0" villagerId="2001">
